class Solution:
    # Function to find the maximum element from array arr1 and 
    # the minimum element from array arr2 and return their product.
    def find_multiplication(self, arr1, arr2):
        max=0
        for x in arr1:
            if max < x:
                max=x
        min=float('inf')
        for x in arr2:
            if min > x:
                min=x
        return max*min
